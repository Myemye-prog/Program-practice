# 7. Rotate Image (in-place)
# =============================================
def rotate(matrix):
    """
    You are given an n x n 2D matrix representing an image, 
    rotate the image by 90 degrees (clockwise).
    You have to rotate the image in-place.
    """
    n = len(matrix)
    # Transpose
    for i in range(n):
        for j in range(i + 1, n):
            matrix[i][j], matrix[j][i] = matrix[j][i], matrix[i][j]
    # Reverse each row
    for row in matrix:
        row.reverse()

def test_rotate_image():
    matrix = [
        [1, 2, 3],
        [4, 5, 6],
        [7, 8, 9]
    ]
    rotate(matrix)
    print("Rotate Image:")
    for row in matrix:
        print(row)
    # Expected:
    # [7, 4, 1]
    # [8, 5, 2]
    # [9, 6, 3]

