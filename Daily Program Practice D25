# 10. CHECK ANAGRAM
# ============================================================
# Problem:
# Check whether two strings are anagrams.
#
# Example:
# Input:  "listen", "silent"
# Output: True


def is_anagram(s1, s2):
    return sorted(s1.lower()) == sorted(s2.lower())


print("\n10. Anagram:")
print(is_anagram("listen", "silent"))


