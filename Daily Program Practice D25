# 1. REVERSE A STRING
# ============================================================
# Problem:
# Given a string, return the string in reverse order.
#
# Example:
# Input:  "hello"
# Output: "olleh"


def reverse_string(s):
    return s[::-1]


print("1. Reverse String:")
print(reverse_string("hello"))


