# 1. Reverse a String
# ------------------------------------------------------------
# Example:
# Input:  "hello"
# Output: "olleh"

def reverse_string(s):
    return s[::-1]


# 2. Check Palindrome
# ------------------------------------------------------------
# Example:
# Input:  "madam"
# Output: True

def is_palindrome(s):
    return s == s[::-1]


# 3. Count Vowels and Consonants
# ------------------------------------------------------------
# Example:
# Input: "hello world"
# Output: Vowels = 3, Consonants = 7

def count_vowels_consonants(s):
    vowels = "aeiouAEIOU"
    vowel_count = 0
    consonant_count = 0

    for ch in s:
        if ch.isalpha():
            if ch in vowels:
                vowel_count += 1
            else:
                consonant_count += 1

    return vowel_count, consonant_count


# 4. Find Frequency of Each Character
# ------------------------------------------------------------
# Example:
# Input: "programming"
# Output: {'p': 1, 'r': 2, 'o': 1, ...}

def character_frequency(s):
    freq = {}

    for ch in s:
        freq[ch] = freq.get(ch, 0) + 1

    return freq


# 5. Find First Non-Repeating Character
# ------------------------------------------------------------
# Example:
# Input: "swiss"
# Output: "w"

def first_non_repeating(s):
    freq = {}

    for ch in s:
        freq[ch] = freq.get(ch, 0) + 1

    for ch in s:
        if freq[ch] == 1:
            return ch

    return None


# 6. Find First Repeating Character
# ------------------------------------------------------------
# Example:
# Input: "programming"
# Output: "r"

def first_repeating(s):
    seen = set()

    for ch in s:
        if ch in seen:
            return ch
        seen.add(ch)

    return None


# 7. Remove Duplicate Characters
# ------------------------------------------------------------
# Example:
# Input: "programming"
# Output: "progamin"

def remove_duplicates(s):
    seen = set()
    result = []

    for ch in s:
        if ch not in seen:
            seen.add(ch)
            result.append(ch)

    return "".join(result)


# 8. Check Anagram
# ------------------------------------------------------------
# Example:
# Input:
# "listen"
# "silent"
# Output: True

def are_anagrams(s1, s2):
    return sorted(s1) == sorted(s2)


# 9. Count Words in a String
# ------------------------------------------------------------
# Example:
# Input: "I love data structures"
# Output: 4

def count_words(s):
    return len(s.split())


# 10. Reverse Words in a String
# ------------------------------------------------------------
# Example:
# Input: "I love coding"
# Output: "coding love I"

def reverse_words(s):
    return " ".join(s.split()[::-1])


# 11. Find Longest Word
# ------------------------------------------------------------
# Example:
# Input: "I am learning programming"
# Output: "programming"

def longest_word(s):
    words = s.split()

    if not words:
        return ""

    longest = words[0]

    for word in words:
        if len(word) > len(longest):
            longest = word

    return longest


# 12. Check String Rotation
# ------------------------------------------------------------
# Example:
# s1 = "abcd"
# s2 = "cdab"
# Output: True

def is_rotation(s1, s2):
    if len(s1) != len(s2):
        return False

    return s2 in (s1 + s1)


# 13. Longest Substring Without Repeating Characters
# ------------------------------------------------------------
# Example:
# Input: "abcabcbb"
# Output: 3
#
# Explanation:
# Longest substring = "abc"

def longest_unique_substring(s):
    char_index = {}
    left = 0
    max_length = 0

    for right in range(len(s)):
        ch = s[right]

        if ch in char_index and char_index[ch] >= left:
            left = char_index[ch] + 1

        char_index[ch] = right

        max_length = max(max_length, right - left + 1)

    return max_length


# 14. Longest Palindromic Substring
# ------------------------------------------------------------
# Example:
# Input: "babad"
# Output: "bab" or "aba"

def longest_palindromic_substring(s):

    if not s:
        return ""

    start = 0
    end = 0

    def expand(left, right):
        while left >= 0 and right < len(s) and s[left] == s[right]:
            left -= 1
            right += 1

        return left + 1, right - 1

    for i in range(len(s)):

        # Odd length palindrome
        left1, right1 = expand(i, i)

        # Even length palindrome
        left2, right2 = expand(i, i + 1)

        if right1 - left1 > end - start:
            start, end = left1, right1

        if right2 - left2 > end - start:
            start, end = left2, right2

    return s[start:end + 1]


# 15. String Compression
# ------------------------------------------------------------
# Example:
# Input: "aaabbcccc"
# Output: "a3b2c4"

def compress_string(s):
    if not s:
        return ""

    result = []
    count = 1

    for i in range(1, len(s) + 1):

        if i < len(s) and s[i] == s[i - 1]:
            count += 1

        else:
            result.append(s[i - 1])
            result.append(str(count))
            count = 1

    return "".join(result)


# 16. Valid Parentheses
# ------------------------------------------------------------
# Example:
# Input: "{[()]}"
# Output: True
#
# Input: "{[(])}"
# Output: False

def valid_parentheses(s):
    stack = []

    pairs = {
        ')': '(',
        ']': '[',
        '}': '{'
    }

    for ch in s:

        if ch in "([{":
            stack.append(ch)

        elif ch in ")]}":

            if not stack:
                return False

            if stack.pop() != pairs[ch]:
                return False

    return len(stack) == 0


# 17. Minimum Window Substring
# ------------------------------------------------------------
# Example:
# s = "ADOBECODEBANC"
# t = "ABC"
# Output: "BANC"

from collections import Counter


def minimum_window(s, t):

    if not s or not t:
        return ""

    target = Counter(t)

    window = {}

    have = 0
    need = len(target)

    left = 0

    min_length = float("inf")
    min_start = 0

    for right in range(len(s)):

        ch = s[right]

        window[ch] = window.get(ch, 0) + 1

        if ch in target and window[ch] == target[ch]:
            have += 1

        while have == need:

            current_length = right - left + 1

            if current_length < min_length:
                min_length = current_length
                min_start = left

            left_char = s[left]

            window[left_char] -= 1

            if (
                left_char in target
                and window[left_char] < target[left_char]
            ):
                have -= 1

            left += 1

    if min_length == float("inf"):
        return ""

    return s[min_start:min_start + min_length]


# 18. Group Anagrams
# ------------------------------------------------------------
# Example:
# Input:
# ["eat", "tea", "tan", "ate", "nat", "bat"]
#
# Output:
# [
#   ["eat", "tea", "ate"],
#   ["tan", "nat"],
#   ["bat"]
# ]

from collections import defaultdict


def group_anagrams(words):

    groups = defaultdict(list)

    for word in words:
        key = "".join(sorted(word))
        groups[key].append(word)

    return list(groups.values())


# 19. Longest Common Subsequence (LCS)
# ------------------------------------------------------------
# Example:
# s1 = "abcde"
# s2 = "ace"
# Output: 3
#
# LCS = "ace"

def longest_common_subsequence(s1, s2):

    m = len(s1)
    n = len(s2)

    dp = [[0] * (n + 1) for _ in range(m + 1)]

    for i in range(1, m + 1):

        for j in range(1, n + 1):

            if s1[i - 1] == s2[j - 1]:
                dp[i][j] = dp[i - 1][j - 1] + 1

            else:
                dp[i][j] = max(
                    dp[i - 1][j],
                    dp[i][j - 1]
                )

    return dp[m][n]


# 20. Edit Distance
# ------------------------------------------------------------
# Example:
# s1 = "horse"
# s2 = "ros"
# Output: 3
#
# Operations:
# Replace h -> r
# Delete r
# Delete e

def edit_distance(s1, s2):

    m = len(s1)
    n = len(s2)

    dp = [[0] * (n + 1) for _ in range(m + 1)]

    # Convert empty string to s2
    for j in range(n + 1):
        dp[0][j] = j

    # Convert s1 to empty string
    for i in range(m + 1):
        dp[i][0] = i

    for i in range(1, m + 1):

        for j in range(1, n + 1):

            if s1[i - 1] == s2[j - 1]:

                dp[i][j] = dp[i - 1][j - 1]

            else:

                insert = dp[i][j - 1]
                delete = dp[i - 1][j]
                replace = dp[i - 1][j - 1]

                dp[i][j] = 1 + min(
                    insert,
                    delete,
                    replace
                )

    return dp[m][n]


