# Dictionary frequency counter
text = "programming"

frequency = {}

for char in text:
    if char in frequency:
        frequency[char] += 1
    else:
        frequency[char] = 1

print("Character Frequency:")
print(frequency)
# Merge dictionaries
student = {
    "name": "John",
    "age": 20
}

marks = {
    "math": 90,
    "science": 95
}

merged = {**student, **marks}

print("Merged Dictionary:")
print(merged)
# Lambda + sorted
students = [
    ("Alice", 90),
    ("Bob", 75),
    ("Charlie", 85),
    ("David", 95)
]

sorted_students = sorted(students, key=lambda student: student[1])

print("Sorted by Marks:")

for student in sorted_students:
    print(student)
