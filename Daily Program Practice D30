# --------------------------------------------------
# TOP TRACKS BY ARTIST
# --------------------------------------------------

def artist_top_tracks():

    artist_name = input("\nEnter artist name: ").strip()

    if not artist_name:
        print("Please enter an artist name.")
        return

    try:

        results = spotify.search(
            q=artist_name,
            type="artist",
            limit=1
        )

        artists = results["artists"]["items"]

        if not artists:
            print("Artist not found.")
            return

        artist = artists[0]

        print(f"\nArtist: {artist['name']}")
        print("-" * 60)

        top_tracks = spotify.artist_top_tracks(
            artist["id"],
            country="IN"
        )

        tracks = top_tracks["tracks"]

        if not tracks:
            print("No top tracks found.")
            return

        for i, track in enumerate(tracks, start=1):

            print(f"{i}. {track['name']}")
            print(f"   Album: {track['album']['name']}")
            print()

        choice = input(
            "Enter result number to open in Spotify "
            "(or press Enter to return): "
        ).strip()

        if choice.isdigit():

            number = int(choice)

            if 1 <= number <= len(tracks):

                url = tracks[number - 1]["external_urls"]["spotify"]

                webbrowser.open(url)

            else:
                print("Invalid result number.")

    except Exception as e:
        print("Error:", e)


# --------------------------------------------------
# FEATURED PLAYLISTS
# --------------------------------------------------

def search_playlists():

    query = input("\nEnter playlist name: ").strip()

    if not query:
        print("Please enter a playlist name.")
        return

    try:

        results = spotify.search(
            q=query,
            type="playlist",
            limit=10
        )

        playlists = results["playlists"]["items"]

        if not playlists:
            print("No playlists found.")
            return

        print("\nPLAYLIST RESULTS")
        print("-" * 60)

        valid_playlists = []

        for playlist in playlists:

            if playlist is None:
                continue

            valid_playlists.append(playlist)

        for i, playlist in enumerate(valid_playlists, start=1):

            print(f"{i}. {playlist['name']}")
            print(f"   Owner: {playlist['owner']['display_name']}")
            print()

        choice = input(
            "Enter result number to open in Spotify "
            "(or press Enter to return): "
        ).strip()

        if choice.isdigit():

            number = int(choice)

            if 1 <= number <= len(valid_playlists):

                url = valid_playlists[number - 1][
                    "external_urls"
                ]["spotify"]

                webbrowser.open(url)

            else:
                print("Invalid result number.")

    except Exception as e:
        print("Error:", e)


# --------------------------------------------------
# MAIN MENU
# --------------------------------------------------

def main():

    while True:

        header()

        print("1. Search Songs")
        print("2. Search Artists")
        print("3. Search Albums")
        print("4. Artist Top Tracks")
        print("5. Search Playlists")
        print("6. Exit")

        print("-" * 60)

        choice = input("Enter your choice: ").strip()

        if choice == "1":
            search_tracks()

        elif choice == "2":
            search_artists()

        elif choice == "3":
            search_albums()

        elif choice == "4":
            artist_top_tracks()

        elif choice == "5":
            search_playlists()

        elif choice == "6":
            print("\nThank you for using Spotify Music Explorer!")
            break

        else:
            print("\nInvalid choice. Please try again.")

        input("\nPress Enter to continue...")


# --------------------------------------------------
# PROGRAM START
# --------------------------------------------------

if __name__ == "__main__":
    main()