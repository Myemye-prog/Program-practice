"""
Spotify Music Explorer
Author: Your Name

Features:
- Spotify API connection
- Search tracks
- Search artists
- Search albums
- Display details
- Open results in Spotify

Install:
    pip install spotipy python-dotenv

Create a .env file:
    SPOTIFY_CLIENT_ID=your_client_id
    SPOTIFY_CLIENT_SECRET=your_client_secret
"""

import os
import webbrowser
import spotipy
from spotipy.oauth2 import SpotifyClientCredentials
from dotenv import load_dotenv

# --------------------------------------------------
# LOAD SPOTIFY CREDENTIALS
# --------------------------------------------------

load_dotenv()

CLIENT_ID = os.getenv("SPOTIFY_CLIENT_ID")
CLIENT_SECRET = os.getenv("SPOTIFY_CLIENT_SECRET")

if not CLIENT_ID or not CLIENT_SECRET:
    print("\nERROR: Spotify credentials not found.")
    print("Create a .env file containing:")
    print("SPOTIFY_CLIENT_ID=your_client_id")
    print("SPOTIFY_CLIENT_SECRET=your_client_secret")
    exit()

# --------------------------------------------------
# CONNECT TO SPOTIFY
# --------------------------------------------------

try:
    auth_manager = SpotifyClientCredentials(
        client_id=CLIENT_ID,
        client_secret=CLIENT_SECRET
    )

    spotify = spotipy.Spotify(auth_manager=auth_manager)

except Exception as e:
    print("Spotify connection failed:", e)
    exit()

# --------------------------------------------------
# DISPLAY HEADER
# --------------------------------------------------

def header():
    print("\n" + "=" * 60)
    print("              SPOTIFY MUSIC EXPLORER")
    print("=" * 60)


# --------------------------------------------------
# SEARCH TRACKS
# --------------------------------------------------

def search_tracks():

    query = input("\nEnter song name: ").strip()

    if not query:
        print("Please enter a song name.")
        return

    try:
        results = spotify.search(
            q=query,
            type="track",
            limit=10
        )

        tracks = results["tracks"]["items"]

        if not tracks:
            print("No songs found.")
            return

        print("\nSEARCH RESULTS")
        print("-" * 60)

        for i, track in enumerate(tracks, start=1):

            artists = ", ".join(
                artist["name"]
                for artist in track["artists"]
            )

            print(f"{i}. {track['name']}")
            print(f"   Artist : {artists}")
            print(f"   Album  : {track['album']['name']}")
            print()

        choice = input(
            "Enter result number to open in Spotify "
            "(or press Enter to return): "
        ).strip()

        if choice.isdigit():

            number = int(choice)

            if 1 <= number <= len(tracks):

                url = tracks[number - 1]["external_urls"]["spotify"]

                print("\nOpening Spotify...")
                webbrowser.open(url)

            else:
                print("Invalid result number.")

    except Exception as e:
        print("Error:", e)


