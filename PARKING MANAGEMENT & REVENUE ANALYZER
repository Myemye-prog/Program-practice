# Add a new vehicle

def add_vehicle():
print("\n--- Add Vehicle ---")

```
try:
    ticket = int(input("Enter ticket number: "))

    # Check ticket number
    for vehicle in vehicles:
        if vehicle["ticket"] == ticket:
            print("Ticket number already exists.")
            return

    number = input("Enter vehicle number: ").strip().upper()
    owner = input("Enter owner name: ").strip().title()

    if number == "" or owner == "":
        print("Vehicle number and owner name are required.")
        return

    print("\nVehicle Types:")
    for item in vehicle_types:
        print(item)

    vehicle_type = input("Enter vehicle type: ").strip().title()

    if vehicle_type not in vehicle_types:
        print("Invalid vehicle type.")
        return

    hours = float(input("Enter parking hours: "))

    if hours <= 0:
        print("Hours should be greater than zero.")
        return

    vehicle = {
        "ticket": ticket,
        "number": number,
        "owner": owner,
        "type": vehicle_type,
        "hours": hours
    }

    vehicles.append(vehicle)

    fee = calculate_fee(vehicle_type, hours)

    print("Vehicle added successfully.")
    print("Parking fee: ₹", fee)

except ValueError:
    print("Please enter a valid value.")
```

# Show all parked vehicles

def show_vehicles():
print("\n--- Parked Vehicles ---")

```
if len(vehicles) == 0:
