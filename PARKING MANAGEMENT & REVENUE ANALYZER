# Find average parking fee

def average_fee():
print("\n--- Average Parking Fee ---")

```
if len(vehicles) == 0:
    print("No vehicles found.")
    return

fees = []

for vehicle in vehicles:
    fee = calculate_fee(
        vehicle["type"],
        vehicle["hours"]
    )
    fees.append(fee)

fee_array = np.array(fees)

average = np.mean(fee_array)

print("Average parking fee: ₹", round(average, 2))
```

