# Search vehicle by number

def search_vehicle():
print("\n--- Search Vehicle ---")

```
number = input("Enter vehicle number: ").strip().upper()

for vehicle in vehicles:

    if vehicle["number"] == number:

        fee = calculate_fee(
            vehicle["type"],
            vehicle["hours"]
        )

