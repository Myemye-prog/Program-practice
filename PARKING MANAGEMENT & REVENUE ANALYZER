# Remove vehicle when it leaves

def exit_vehicle():
print("\n--- Vehicle Exit ---")

```
try:
    ticket = int(input("Enter ticket number: "))

    for vehicle in vehicles:

        if vehicle["ticket"] == ticket:

            fee = calculate_fee(
                vehicle["type"],
                vehicle["hours"]
            )

            print("\nVehicle details")
            print("Number:", vehicle["number"])
            print("Owner :", vehicle["owner"])
            print("Fee   : ₹", fee)

            confirm = input("Vehicle leaving? (y/n): ").strip().lower()

            if confirm == "y":
                vehicles.remove(vehicle)
                print("Vehicle removed from parking.")

            else:
                print("Exit cancelled.")

            return

    print("Ticket not found.")

except ValueError:
    print("Enter a valid ticket number.")
```

# Show vehicle with highest parking fee

def highest_fee():
print("\n--- Highest Parking Fee ---")

```
if len(vehicles) == 0:
    print("No vehicles found.")
    return

fees = []

for vehicle in vehicles:
    fee = calculate_fee(
        vehicle["type"],
        vehicle["hours"]
    )
    fees.append(fee)

fee_array = np.array(fees)
highest = np.max(fee_array)

for vehicle in vehicles:

    fee = calculate_fee(
        vehicle["type"],
        vehicle["hours"]
    )

    if fee == highest:
        print("Vehicle:", vehicle["number"])
        print("Owner  :", vehicle["owner"])
        print("Fee    : ₹", highest)
```

