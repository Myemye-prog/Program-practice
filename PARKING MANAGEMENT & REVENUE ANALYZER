# Count each type of vehicle

def vehicle_summary():
print("\n--- Vehicle Summary ---")

```
summary = {
    "Car": 0,
    "Bike": 0,
    "Auto": 0,
    "Truck": 0
}

for vehicle in vehicles:
    vehicle_type = vehicle["type"]
    summary[vehicle_type] += 1

for vehicle_type, count in summary.items():
    print(vehicle_type, ":", count)
```

# Delete a parking record

def delete_vehicle():
print("\n--- Delete Record ---")

```
try:
    ticket = int(input("Enter ticket number: "))

    for vehicle in vehicles:

        if vehicle["ticket"] == ticket:

            confirm = input(
                "Delete this record? (y/n): "
            ).strip().lower()

            if confirm == "y":
                vehicles.remove(vehicle)
                print("Record deleted.")
            else:
                print("Delete cancelled.")

            return

    print("Ticket not found.")

except ValueError:
    print("Enter a valid ticket number.")
```

