        return

print("Vehicle not found.")
```

# Calculate fee without adding a vehicle

def show_fee():
print("\n--- Parking Fee Calculator ---")

```
print("Vehicle Types:")

for item in vehicle_types:
    print(item)

vehicle_type = input("Enter vehicle type: ").strip().title()

if vehicle_type not in vehicle_types:
