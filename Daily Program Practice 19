# ==========================================
# 12. Lock Example
# ==========================================
def program12():
    count = [0]
    lock = threading.Lock()

    def increase():
        for _ in range(1000):
            with lock:
                count[0] += 1

    t1 = threading.Thread(target=increase)
    t2 = threading.Thread(target=increase)

    t1.start()
    t2.start()

    t1.join()
    t2.join()

    print("Count:", count[0])


