# 20. Mini Project - Task Manager
# ==========================================
def program20():
    def complete_task(task_name, seconds):
        print(f"{task_name} started")
        time.sleep(seconds)
        print(f"{task_name} completed")

    tasks = [
        ("Download File", 3),
        ("Process Data", 2),
        ("Send Email", 1)
    ]

    threads = []

    for name, seconds in tasks:
        t = threading.Thread(
            target=complete_task,
            args=(name, seconds)
        )

        threads.append(t)
        t.start()

    for t in threads:
        t.join()

    print("All tasks are completed!")


