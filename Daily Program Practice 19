    lock = threading.Lock()

    def add_numbers(start, end):
        for i in range(start, end):
            with lock:
                numbers.append(i)

    t1 = threading.Thread(
        target=add_numbers,
        args=(1, 6)
    )

    t2 = threading.Thread(
        target=add_numbers,
        args=(6, 11)
    )

    t1.start()
    t2.start()

    t1.join()
    t2.join()

    print(numbers)


# ==========================================
# 15. Bank Account Simulation
# ==========================================
def program15():
    balance = [1000]
    lock = threading.Lock()

    def withdraw(amount):
        with lock:
            if balance[0] >= amount:
                balance[0] -= amount
                print(f"Withdrawn: {amount}")
            else:
                print("Insufficient balance")

    t1 = threading.Thread(target=withdraw, args=(300,))
    t2 = threading.Thread(target=withdraw, args=(500,))

    t1.start()
    t2.start()

    t1.join()
    t2.join()

    print("Final balance:", balance[0])


