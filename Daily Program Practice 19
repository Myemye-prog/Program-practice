# ==========================================
# 18. Producer and Consumer
# ==========================================
def program18():
    items = queue.Queue()

    def producer():
        for i in range(1, 6):
            items.put(i)
            print("Produced:", i)

    def consumer():
        for _ in range(5):
            item = items.get()
            print("Consumed:", item)
            items.task_done()

    t1 = threading.Thread(target=producer)
    t2 = threading.Thread(target=consumer)

    t1.start()
    t2.start()

    t1.join()
    t2.join()


