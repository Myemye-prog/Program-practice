# 1. Check Even or Odd
num = int(input("1. Enter a number: "))

if num % 2 == 0:
    print("Even")
else:
    print("Odd")


# 2. Find Largest of Three Numbers
a = int(input("\n2. Enter first number: "))
b = int(input("Enter second number: "))
c = int(input("Enter third number: "))

print("Largest:", max(a, b, c))


# 3. Reverse a String
text = input("\n3. Enter a string: ")
print("Reversed:", text[::-1])


# 4. Check Palindrome
text = input("\n4. Enter a string: ")

if text == text[::-1]:
    print("Palindrome")
else:
    print("Not Palindrome")


# 5. Find Factorial
num = int(input("\n5. Enter a number: "))

factorial = 1

for i in range(1, num + 1):
    factorial *= i

print("Factorial:", factorial)


# 6. Check Prime Number
num = int(input("\n6. Enter a number: "))

if num < 2:
    print("Not Prime")
else:
    is_prime = True

    for i in range(2, int(num ** 0.5) + 1):
        if num % i == 0:
            is_prime = False
            break

    if is_prime:
        print("Prime")
    else:
        print("Not Prime")


# 7. Sum of Digits
num = int(input("\n7. Enter a number: "))

total = 0
temp = num

while temp > 0:
    total += temp % 10
    temp //= 10

print("Sum of digits:", total)


# 8. Fibonacci Series
n = int(input("\n8. Enter number of terms: "))

a, b = 0, 1

for i in range(n):
    print(a, end=" ")
    a, b = b, a + b

print()


# 9. Count Vowels
text = input("\n9. Enter a string: ")

count = 0

for char in text.lower():
    if char in "aeiou":
        count += 1

print("Number of vowels:", count)


# 10. Find Second Largest Number
numbers = [10, 25, 7, 45, 32, 45]

unique_numbers = list(set(numbers))
unique_numbers.sort()

print("\n10. Numbers:", numbers)
print("Second largest:", unique_numbers[-2])