# ============================================================
# 9. Find Duplicate Characters
# ============================================================

def duplicate_characters(s):
    freq = {}

    for ch in s:
        freq[ch] = freq.get(ch, 0) + 1

    result = []

    for ch in freq:
        if freq[ch] > 1:
            result.append(ch)

    return result

print(duplicate_characters("programming"))
# Output: ['r', 'g', 'm']


