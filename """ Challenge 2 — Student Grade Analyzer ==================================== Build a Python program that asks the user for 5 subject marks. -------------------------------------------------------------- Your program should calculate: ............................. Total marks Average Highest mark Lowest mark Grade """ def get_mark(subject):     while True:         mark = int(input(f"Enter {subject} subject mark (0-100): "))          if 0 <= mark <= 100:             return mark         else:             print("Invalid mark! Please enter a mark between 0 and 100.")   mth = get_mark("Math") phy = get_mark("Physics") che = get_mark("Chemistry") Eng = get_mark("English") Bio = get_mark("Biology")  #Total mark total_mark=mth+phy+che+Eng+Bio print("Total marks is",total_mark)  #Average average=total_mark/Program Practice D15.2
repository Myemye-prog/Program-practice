"""
Challenge 2 — Student Grade Analyzer
====================================
Build a Python program that asks the user for 5 subject marks.
--------------------------------------------------------------
Your program should calculate:
.............................
Total marks
Average
Highest mark
Lowest mark
Grade
"""
def get_mark(subject):
    while True:
        mark = int(input(f"Enter {subject} subject mark (0-100): "))

        if 0 <= mark <= 100:
            return mark
        else:
            print("Invalid mark! Please enter a mark between 0 and 100.")


mth = get_mark("Math")
phy = get_mark("Physics")
che = get_mark("Chemistry")
Eng = get_mark("English")
Bio = get_mark("Biology")

#Total mark
total_mark=mth+phy+che+Eng+Bio
print("Total marks is",total_mark)

#Average
average=total_mark/5
print("Average marks is",average)

#Highest
if mth > phy and mth > che and mth > Eng and mth > Bio:
    highest = mth
elif phy > che and phy > Eng and phy > Bio:
    highest = phy
elif che > Eng and che > Bio:
    highest = che
elif Eng > Bio:
    highest = Eng
else:
    highest = Bio
print(f"The highest mark is {highest}")


highest_mark=max(mth,phy,che,Eng,Bio)
print("Highest marks is",highest_mark)

#Lowest
if mth<phy and mth<che and mth<Eng and mth<Bio:
    lowest=mth
elif phy<che and phy<Eng and phy < Bio:
    lowest=phy
elif Eng<Bio:
    lowest=Eng
else:
    lowest=Bio
print(f"The highest mark is {lowest}")


lowest_mark=min(mth,phy,che,Eng,Bio)
print("Lowest marks is",lowest_mark)

#Grade

if average >= 90:
    grade = "A+"
elif average >= 80:
    grade = "A"
elif average >= 70:
    grade = "B"
elif average >= 60:
    grade = "C"
elif average >= 50:
    grade = "D"
elif average >= 40:
    grade = "E"
else:
    grade = "F"

print("Grade is ",grade)
