"""
Number Analyzer
===============

Task: Write a Python program that:
Takes a number from the user
Checks whether it is positive, negative, or zero
Checks whether it is even or odd
Checks whether it is divisible by 5
"""
num=int(input("Enter a number"))
if num>=0:
    print(f"The {num} is positive number")
elif num<=0:
    print(f"The {num} is negative number")
elif num==0:
    print(f"The {num} is Zero")

if num%2==0:
    print(f"The {num} is a even number")
else:
    print(f"The {num} is a odd number")

if num%5==0:
    print(f"The {num} is divisible by 5")
