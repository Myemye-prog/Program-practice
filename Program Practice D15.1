"""
Number Analyzer
===============

Task: Write a Python program that:
Takes a number from the user
Checks whether it is positive, negative, or zero
Checks whether it is even or odd
Checks whether it is divisible by 5
"""

num = int(input("Enter a number: "))

# Check positive, negative, or zero
if num > 0:
    print(f"The {num} is a positive number")
elif num < 0:
    print(f"The {num} is a negative number")
else:
    print(f"The {num} is zero")


# Check even or odd
if num % 2 == 0:
    print(f"The {num} is an even number")
else:
    print(f"The {num} is an odd number")


# Check divisible by 5
if num % 5 == 0:
    print(f"The {num} is divisible by 5")
else:
    print(f"The {num} is not divisible by 5")
